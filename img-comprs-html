  <script>
    (function() {
      // DOM elements
      const fileInput = document.getElementById('imageInput');
      const dropArea = document.getElementById('dropArea');
      const qualitySlider = document.getElementById('qualitySlider');
      const qualityValue = document.getElementById('qualityValue');
      const compressBtn = document.getElementById('compressBtn');
      const resetBtn = document.getElementById('resetBtn');
      const downloadBtn = document.getElementById('downloadBtn');
      const previewBox = document.getElementById('previewBox');
      const fileNameDisplay = document.getElementById('fileNameDisplay');
      const originalSizeSpan = document.getElementById('originalSize');
      const compressedSizeSpan = document.getElementById('compressedSize');
      const reductionPercentSpan = document.getElementById('reductionPercent');
      const presetBtns = document.querySelectorAll('.preset-btn');

      // State
      let currentFile = null;          // original File object
      let originalImage = null;        // Image object for drawing
      let compressedBlob = null;       // resulting Blob
      let compressedUrl = null;        // object URL for download/preview
      let originalSize = 0;            // bytes

      // Helper: format bytes
      function formatBytes(bytes, decimals = 2) {
        if (bytes === 0 || bytes == null) return '0 B';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
      }

      // Update quality display & active preset
      function updateQualityUI(value) {
        qualityValue.textContent = value + '%';
        qualitySlider.value = value;
        presetBtns.forEach(btn => {
          const q = parseInt(btn.dataset.quality, 10);
          btn.classList.toggle('active', q === parseInt(value, 10));
        });
      }

      // Preset button click
      presetBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const q = btn.dataset.quality;
          updateQualityUI(q);
          // If an image is loaded and compressed already, we could re-compress but we wait for user action
        });
      });

      // Slider input
      qualitySlider.addEventListener('input', (e) => {
        const val = e.target.value;
        qualityValue.textContent = val + '%';
        presetBtns.forEach(btn => {
          const q = parseInt(btn.dataset.quality, 10);
          btn.classList.toggle('active', q === parseInt(val, 10));
        });
      });

      // Reset everything
      function resetAll() {
        if (compressedUrl) {
          URL.revokeObjectURL(compressedUrl);
          compressedUrl = null;
        }
        currentFile = null;
        originalImage = null;
        compressedBlob = null;
        originalSize = 0;
        fileInput.value = '';
        fileNameDisplay.textContent = 'No file';
        originalSizeSpan.textContent = '—';
        compressedSizeSpan.textContent = '—';
        reductionPercentSpan.textContent = '—';
        previewBox.innerHTML = '<div class="placeholder-text">Your image preview will appear here</div>';
        compressBtn.disabled = true;
        downloadBtn.disabled = true;
        updateQualityUI(80);
        // Also reset quality slider to 80
        qualitySlider.value = 80;
        qualityValue.textContent = '80%';
        presetBtns.forEach(btn => {
          const q = parseInt(btn.dataset.quality, 10);
          btn.classList.toggle('active', q === 80);
        });
      }

      // Handle file selection
      function handleFile(file) {
        if (!file || !file.type.startsWith('image/')) {
          alert('Please select a valid image file.');
          return;
        }
        resetAll(); // clear previous

        currentFile = file;
        originalSize = file.size;
        fileNameDisplay.textContent = file.name.length > 30 ? file.name.substring(0, 27) + '…' : file.name;
        originalSizeSpan.textContent = formatBytes(originalSize);
        compressedSizeSpan.textContent = '—';
        reductionPercentSpan.textContent = '—';

        // Load image for preview and drawing
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            originalImage = img;
            // Show original preview (before compression)
            previewBox.innerHTML = '';
            const previewImg = document.createElement('img');
            previewImg.src = e.target.result;
            previewImg.alt = 'Original image preview';
            previewBox.appendChild(previewImg);
            compressBtn.disabled = false;
            downloadBtn.disabled = true;
          };
          img.onerror = () => {
            alert('Could not load image.');
            resetAll();
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      // File input change
      fileInput.addEventListener('change', (e) => {
        if (e.target.files.length) {
          handleFile(e.target.files[0]);
        }
      });

      // Drag and drop
      dropArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropArea.style.borderColor = '#3b7cff';
        dropArea.style.background = '#f0f7ff';
      });
      dropArea.addEventListener('dragleave', () => {
        dropArea.style.borderColor = '#b7c9e2';
        dropArea.style.background = '#ffffff';
      });
      dropArea.addEventListener('drop', (e) => {
        e.preventDefault();
        dropArea.style.borderColor = '#b7c9e2';
        dropArea.style.background = '#ffffff';
        const files = e.dataTransfer.files;
        if (files.length) {
          handleFile(files[0]);
        }
      });

      // Compress action
      function compressImage() {
        if (!originalImage || !currentFile) return;

        const quality = parseInt(qualitySlider.value, 10) / 100; // 0..1

        // Create canvas
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        // Use natural dimensions (avoid upscaling)
        let width = originalImage.naturalWidth;
        let height = originalImage.naturalHeight;
        // If image is very large, we could cap dimensions but we keep original size for quality
        canvas.width = width;
        canvas.height = height;
        ctx.drawImage(originalImage, 0, 0, width, height);

        // Determine output format: for PNG, we may keep PNG but with quality? PNG compression uses quality param but only for certain browsers.
        // For better size reduction, we convert to JPEG unless original is PNG with transparency (then keep PNG).
        // Simple approach: use image/jpeg for all except if file type is png and we need transparency -> we detect? Better keep original mime, but for PNG, quality parameter works in Chrome/Edge but not everywhere. We'll use JPEG for smaller size but preserve original type if PNG and transparency? Let's be safe: if original type is PNG, we output PNG to preserve transparency, otherwise JPEG.
        let mimeType = 'image/jpeg';
        if (currentFile.type === 'image/png') {
          mimeType = 'image/png';
        } else if (currentFile.type === 'image/webp') {
          mimeType = 'image/webp';
        } else {
          mimeType = 'image/jpeg';
        }

        // For PNG, quality parameter might be ignored, but we still pass it (some browsers support).
        canvas.toBlob(
          (blob) => {
            if (!blob) {
              alert('Compression failed. Try a different image.');
              return;
            }
            // Clean previous compressed url
            if (compressedUrl) {
              URL.revokeObjectURL(compressedUrl);
            }
            compressedBlob = blob;
            compressedUrl = URL.createObjectURL(blob);

            // Update stats
            const compressedSize = blob.size;
            compressedSizeSpan.textContent = formatBytes(compressedSize);
            const reduction = ((originalSize - compressedSize) / originalSize) * 100;
            reductionPercentSpan.textContent = reduction > 0 ? reduction.toFixed(1) + '%' : '0%';

            // Update preview with compressed version
            previewBox.innerHTML = '';
            const compImg = document.createElement('img');
            compImg.src = compressedUrl;
            compImg.alt = 'Compressed image preview';
            previewBox.appendChild(compImg);

            downloadBtn.disabled = false;
          },
          mimeType,
          quality
        );
      }

      compressBtn.addEventListener('click', compressImage);

      // Download
      downloadBtn.addEventListener('click', () => {
        if (!compressedBlob || !compressedUrl) return;
        const a = document.createElement('a');
        a.href = compressedUrl;
        // Generate filename
        let baseName = currentFile.name.replace(/\.[^.]+$/, '');
        let ext = 'jpg';
        if (currentFile.type === 'image/png') ext = 'png';
        else if (currentFile.type === 'image/webp') ext = 'webp';
        else if (currentFile.type === 'image/bmp') ext = 'bmp';
        // Use mime type from blob to be precise
        if (compressedBlob.type === 'image/png') ext = 'png';
        else if (compressedBlob.type === 'image/webp') ext = 'webp';
        a.download = `${baseName}-compressed.${ext}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });

      // Reset
      resetBtn.addEventListener('click', resetAll);

      // Initialize UI
      updateQualityUI(80);
      resetAll();

      // Ensure ad slots are pushed after any dynamic content (already inline but safe)
      // Some browsers need extra push if dynamically added later, not needed here.
    })();
  </script>
